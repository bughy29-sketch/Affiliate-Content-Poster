# Pinterest app credentials (https://developers.pinterest.com/)
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_REFRESH_TOKEN=

# Optional: board implicit dacă pinul nu are board_id
PINTEREST_BOARD_ID=

# Siguranță: true = validează fără să publice
DRY_RUN=true

# Limite și ritm
MAX_PINS_PER_RUN=3
MIN_DELAY_SECONDS=30
MAX_DELAY_SECONDS=90

# Text adăugat automat la pinurile cu afiliere
AFFILIATE_DISCLOSURE=Conține linkuri de afiliere. Putem primi un comision fără cost suplimentar pentru tine.

# Căi
QUEUE_PATH=data/queue.json
STATE_PATH=data/state.json

# Feed Profitshare (eMAG) — URL-ul din contul de afiliat, ține-l doar local
PROFITSHARE_FEED_URL=

# Amazon Associates tag (ex. numesite-21)
AMAZON_TAG=
